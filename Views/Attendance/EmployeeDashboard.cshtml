@model List<HRMS_MVC.Models.Attendance>

<link rel="stylesheet" href="~/css/site.css" />

<div class="container py-5">

    <!-- Hero Section -->

    <div class="hero-section mb-4">

        <div class="hero-content">

            <div>

                <h1 class="hero-title">
                    Welcome Back 👋
                </h1>

                <p class="hero-subtitle">
                    Track your attendance, manage working hours,
                    and monitor your daily activity easily.
                </p>

            </div>

            <div class="hero-icon">
                🧑‍💻
            </div>

        </div>

    </div>

    <!-- Action Buttons -->

    <div class="attendance-action-card mb-4">

        <div class="d-flex gap-3 flex-wrap">

            <form method="post" action="/Attendance/CheckIn">

                <button class="custom-btn checkin-btn">
                    Check In
                </button>

            </form>

            <form method="post" action="/Attendance/CheckOut">

                <button class="custom-btn checkout-btn">
                    Check Out
                </button>

            </form>

        </div>

    </div>

    <!-- Attendance Records -->

    <div class="custom-table p-4">

        <!-- Table Header -->

        <div class="d-flex justify-content-between align-items-center mb-3">

            <h5 class="fw-semibold mb-0">
                My Attendance Records
            </h5>

            <span class="text-muted">
                Total Records: @Model.Count
            </span>

        </div>

        <!-- Attendance Table -->

        <table class="table align-middle">

            <thead>

                <tr>

                    <th>Date</th>

                    <th>Check In</th>

                    <th>Check Out</th>

                    <th>Hours</th>

                    <th>Status</th>

                    <th>Leave Deduction</th>

                </tr>

            </thead>

            <tbody>

                @if(Model.Count == 0)
                {
                    <tr>

                        <td colspan="6"
                            class="text-center text-muted py-4">

                            No attendance records found

                        </td>

                    </tr>
                }

                else
                {
                    @foreach(var item in Model)
                    {
                        <tr>

                            <td>
                                @item.AttendanceDate.ToShortDateString()
                            </td>

                            <td>
                                @(item.CheckInTime?.ToString("dd/MM/yyyy hh:mm:ss tt") ?? "-")
                            </td>

                            <td>
                                @(item.CheckOutTime?.ToString("dd/MM/yyyy hh:mm:ss tt") ?? "-")
                            </td>

                            <td>
                                @item.WorkingHours hrs
                            </td>

                            <td>

                                @{
                                    var statusClass = item.Status switch
                                    {
                                        "Present" => "present",
                                        "Half Day" => "halfday",
                                        "Absent" => "absent",
                                        _ => "pending"
                                    };
                                }

                                <span class="status-badge @statusClass">

                                    @item.Status

                                </span>

                            </td>

                            <td>

                                @if(item.LeaveDeduction == 0)
                                {
                                    <span class="status-badge present">
                                        No Leave
                                    </span>
                                }
                                else if(item.LeaveDeduction == 0.5m)
                                {
                                    <span class="status-badge halfday">
                                        0.5 Day
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge absent">
                                        1 Day
                                    </span>
                                }

                            </td>

                        </tr>
                    }
                }

            </tbody>

        </table>

    </div>

</div>